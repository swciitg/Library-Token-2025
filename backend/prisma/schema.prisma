generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
        

model Slot {
  slot_id  Int     @id 
  is_empty Boolean @default(true)

  // back-relation
  entry    Entry?  // Slot can have 0 or 1 Entry
}

model Entry {
  roll_no        Int      @id
  allocated_slot Int      @unique
  timestamp      DateTime @default(now())

  // relation to Slot (foreign key side)
  slot Slot @relation(fields: [allocated_slot], references: [slot_id])
}
